<?xml version="1.0" encoding="utf-8"?>
<!-- Original, text-only native MSI dialogs. No third-party UI artwork or custom-action DLLs.
     Full UI gets welcome (with the desktop-shortcut checkbox)/progress/outcome screens; /qn and /qb stay unattended. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="PdfcraftInstallerUI">
      <TextStyle Id="InstallerNormal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="InstallerTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
      <Property Id="DefaultUIFont" Value="InstallerNormal" />

      <Dialog Id="InstallWelcome" Width="420" Height="225" Title="!(loc.SetupTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="380" Height="25" Text="{\InstallerTitle}!(loc.WelcomeTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="380" Height="40"
            Text="!(loc.WelcomeDescription)" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="105" Width="380" Height="17"
            Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="!(loc.DesktopShortcut)" />
        <Control Id="HotFolder" Type="CheckBox" X="20" Y="130" Width="380" Height="17"
            Property="INSTALLHOTFOLDER" CheckBoxValue="1" Text="!(loc.HotFolderCheckbox)" />
        <Control Id="HotFolderDescription" Type="Text" X="32" Y="150" Width="368" Height="30"
            Text="!(loc.HotFolderDescription)" />
        <Control Id="Install" Type="PushButton" X="195" Y="190" Width="100" Height="23" Default="yes" ElevationShield="yes" Text="!(loc.Install)">
          <!-- CostFinalize precedes the welcome dialog, so apply the user's feature choice here. -->
          <Publish Event="AddLocal" Value="HotFolder" Condition="INSTALLHOTFOLDER = 1" Order="1" />
          <Publish Event="Remove" Value="HotFolder" Condition="INSTALLHOTFOLDER &lt;&gt; 1" Order="2" />
          <Publish Property="INSTALLHOTFOLDER" Value="0" Condition="INSTALLHOTFOLDER &lt;&gt; 1" Order="3" />
          <Publish Event="EndDialog" Value="Return" Order="4" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="190" Width="100" Height="23" Cancel="yes" Text="!(loc.Cancel)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallMaintenance" Width="420" Height="225" Title="!(loc.SetupTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="380" Height="25" Text="{\InstallerTitle}!(loc.MaintenanceTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="380" Height="70"
            Text="!(loc.MaintenanceDescription)" />
        <Control Id="AddHotFolder" Type="PushButton" X="20" Y="130" Width="380" Height="23" ElevationShield="yes"
            Text="!(loc.AddHotFolder)" HideCondition="!HotFolder = 3" ShowCondition="!HotFolder &lt;&gt; 3">
          <Publish Event="AddLocal" Value="HotFolder" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="RemoveHotFolder" Type="PushButton" X="20" Y="130" Width="380" Height="23" ElevationShield="yes"
            Text="!(loc.RemoveHotFolder)" HideCondition="!HotFolder &lt;&gt; 3" ShowCondition="!HotFolder = 3">
          <Publish Event="Remove" Value="HotFolder" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Repair" Type="PushButton" X="90" Y="190" Width="100" Height="23" Default="yes" ElevationShield="yes" Text="!(loc.Repair)">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="195" Y="190" Width="100" Height="23" ElevationShield="yes" Text="!(loc.Remove)">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="190" Width="100" Height="23" Cancel="yes" Text="!(loc.Cancel)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallProgress" Width="420" Height="180" Title="!(loc.SetupTitle)" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="380" Height="25" Text="{\InstallerTitle}!(loc.ProgressTitle)" />
        <!-- No ActionText table is authored: subscribing would blank this message (#305). -->
        <Control Id="Status" Type="Text" X="20" Y="60" Width="380" Height="40" Text="!(loc.ProgressDescription)" />
        <Control Id="Progress" Type="ProgressBar" X="20" Y="110" Width="380" Height="15" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="145" Width="100" Height="23" Cancel="yes" Text="!(loc.Cancel)">
          <Publish Event="SpawnDialog" Value="ConfirmCancel" />
        </Control>
      </Dialog>

      <Dialog Id="ConfirmCancel" Width="340" Height="110" Title="!(loc.ConfirmCancelTitle)">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="300" Height="35" Text="!(loc.ConfirmCancelDescription)" />
        <Control Id="Yes" Type="PushButton" X="110" Y="70" Width="100" Height="23" Text="!(loc.Yes)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="220" Y="70" Width="100" Height="23" Default="yes" Cancel="yes" Text="!(loc.No)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallComplete" Width="420" Height="180" Title="!(loc.SetupTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="380" Height="25" Text="{\InstallerTitle}!(loc.CompleteTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="380" Height="70"
            Text="!(loc.CompleteDescription)" />
        <Control Id="Finish" Type="PushButton" X="300" Y="145" Width="100" Height="23" Default="yes" Cancel="yes" Text="!(loc.Finish)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallFailed" Width="420" Height="180" Title="!(loc.SetupTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="380" Height="25" Text="{\InstallerTitle}!(loc.FailedTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="380" Height="70"
            Text="!(loc.FailedDescription)" />
        <Control Id="Finish" Type="PushButton" X="300" Y="145" Width="100" Height="23" Default="yes" Cancel="yes" Text="!(loc.Finish)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallCancelled" Width="420" Height="180" Title="!(loc.SetupTitle)">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="380" Height="25" Text="{\InstallerTitle}!(loc.CancelledTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="380" Height="70"
            Text="!(loc.CancelledDescription)" />
        <Control Id="Finish" Type="PushButton" X="300" Y="145" Width="100" Height="23" Default="yes" Cancel="yes" Text="!(loc.Finish)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Shown by Windows Installer (Restart Manager) when an upgrade or repair must replace files
           that a running PdfCraft holds open. OK closes those programs (MSIRMSHUTDOWN=2) and
           continues; Cancel ends setup. -->
      <Dialog Id="MsiRMFilesInUse" Width="420" Height="200" Title="!(loc.SetupTitle)" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="380" Height="25" Text="{\InstallerTitle}!(loc.FilesInUseTitle)" />
        <Control Id="Description" Type="Text" X="20" Y="45" Width="380" Height="30"
            Text="!(loc.FilesInUseDescription)" />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="380" Height="55" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="OK" Type="PushButton" X="195" Y="165" Width="100" Height="23" Default="yes" Text="!(loc.OK)">
          <Publish Property="MSIRMSHUTDOWN" Value="2" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="300" Y="165" Width="100" Height="23" Cancel="yes" Text="!(loc.Cancel)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="InstallWelcome" Before="InstallMaintenance" Condition="UILevel = 5 AND NOT Installed" />
        <Show Dialog="InstallMaintenance" Before="InstallProgress" Condition="UILevel = 5 AND Installed AND NOT REMOVE AND NOT REINSTALL" />
        <Show Dialog="InstallProgress" Before="ExecuteAction" Condition="UILevel = 5" />
        <Show Dialog="InstallComplete" OnExit="success" Condition="UILevel = 5" />
        <Show Dialog="InstallFailed" OnExit="error" Condition="UILevel = 5" />
        <Show Dialog="InstallCancelled" OnExit="cancel" Condition="UILevel = 5" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
